{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mewa UI registry v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "canonicalAssets": {
      "type": "object",
      "properties": {
        "foundations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "licenses": {
          "type": "object",
          "properties": {
            "geist": {
              "type": "string",
              "minLength": 1
            },
            "lucide": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "geist",
            "lucide"
          ],
          "additionalProperties": false
        },
        "icons": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "foundations",
        "fonts",
        "licenses",
        "icons",
        "components",
        "runtime",
        "documentation",
        "system"
      ],
      "additionalProperties": false
    },
    "designTokens": {
      "type": "object",
      "properties": {
        "semantic": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "stability": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "purpose",
              "stability"
            ],
            "additionalProperties": false
          }
        },
        "foundationFamilies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "prefix",
              "purpose"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "semantic",
        "foundationFamilies"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "useWhen": {
            "type": "string",
            "minLength": 1
          },
          "avoidWhen": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          },
          "stability": {
            "type": "string",
            "minLength": 1
          },
          "nativeBasis": {
            "type": "string",
            "minLength": 1
          },
          "docs": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requiresJs": {
            "type": "boolean"
          },
          "enhancementJs": {
            "type": "boolean"
          },
          "jsMode": {
            "enum": [
              "none",
              "optional",
              "required"
            ]
          },
          "styleDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "behaviorDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "files": {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "css": {
                "type": "string",
                "minLength": 1
              },
              "js": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "skill",
              "css"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "slug",
          "category",
          "purpose",
          "useWhen",
          "avoidWhen",
          "fallback",
          "stability",
          "nativeBasis",
          "docs",
          "description",
          "requiresJs",
          "enhancementJs",
          "jsMode",
          "styleDependencies",
          "behaviorDependencies",
          "assets",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "library",
    "canonicalAssets",
    "designTokens",
    "components"
  ],
  "additionalProperties": false
}
